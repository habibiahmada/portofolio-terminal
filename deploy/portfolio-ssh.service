[Unit]
Description=Habibi Ahmad SSH Portfolio (Wish + Bubble Tea TUI)
Documentation=https://habibiahmada.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/habibiahmada
ExecStart=/opt/habibiahmada/habibiahmada-ssh
Environment=SSH_PORT=22
Environment=SSH_HOST_KEY_PATH=/opt/habibiahmada/term_info_ed25519
Environment=SSH_MAX_SESSIONS=64
Environment=SSH_IDLE_TIMEOUT=30m
Environment=SSH_MAX_TIMEOUT=2h
Environment=SSH_RATE_LIMIT=1
Environment=SSH_RATE_BURST=5
Restart=always
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

LimitNOFILE=65535

PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/habibiahmada

[Install]
WantedBy=multi-user.target
